NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Neon PostgreSQL Database Connection (Use -pooler URL with connection_limit=10 for Free Tier)
# Example: postgresql://[user]:[password]@[ep-xyz]-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/amra_muhammadpuri_dev?schema=public"

# Better Auth Configuration (Set BETTER_AUTH_URL to your Render backend URL, FRONTEND_URL to your Vercel URL)
BETTER_AUTH_SECRET="your-secure-random-32-chars-secret-key-generate-with-openssl"
BETTER_AUTH_URL="https://your-backend-app.onrender.com"
FRONTEND_URL="https://your-frontend-app.vercel.app"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP Transactional Email Configuration (Optional in dev, logs to console if empty)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="আমরা মোহাম্মদপুরী <no-reply@amra-muhammadpuri.org>"

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="amra-muhammadpuri"
